PORT=3000
NODE_ENV=development
APP_TIMEZONE=America/Sao_Paulo

DATABASE_URL=postgresql://usuario:senha@host:5432/banco
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=seu-segredo
JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres
JWT_EXPIRES_IN=8h
JWT_ISSUER=tijucas-imobiliaria
JWT_AUDIENCE=tijucas-imobiliaria-app
AUTH_COOKIE_NAME=tijucas_session
AUTH_COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:5173
APP_TRUST_PROXY=false

# E-mail transacional (use senha de app, nunca a senha principal).
EMAIL_USER=conta@gmail.com
EMAIL_PASS=

# Bucket privado usado pelas URLs pré-assinadas.
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# FAKE para desenvolvimento local; ASAAS para Sandbox/produção.
PAYMENT_GATEWAY_PROVIDER=FAKE
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Entre 32 e 255 caracteres, igual ao authToken cadastrado no webhook Asaas.
ASAAS_WEBHOOK_TOKEN=
ASAAS_USER_AGENT=TijucasImobiliaria/1.0
ASAAS_REQUEST_TIMEOUT_MS=15000
# externalReference não é idempotência nativa no POST de cobranças.
# Habilite somente após homologar no Sandbox e aceitar o risco operacional.
ASAAS_ALLOW_BEST_EFFORT_CHARGE_CREATION=false

BILLING_CRON_SCHEDULE=0 6 * * *
BILLING_LOCK_TIMEOUT_MS=10000
# Inbox Asaas: worker a cada 30s, até 8 tentativas com backoff exponencial
# iniciado em 30s (limitado internamente a 1h).
WEBHOOK_CRON_SCHEDULE=*/30 * * * * *
WEBHOOK_BATCH_SIZE=50
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_BASE_SECONDS=30
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
